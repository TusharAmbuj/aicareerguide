---
import BaseLayout from "@/components/layout/BaseLayout.astro";
---
<BaseLayout title="Contact AI Career Guide" description="Contact AI Career Guide with questions, corrections, suggestions, or collaboration ideas.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">Get in touch</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Contact</h1>
    <p class="mt-4 text-lg leading-8 text-[var(--color-text-secondary)]">Questions, corrections, suggestions, or collaboration ideas are welcome.</p>
    <div class="mt-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)] p-6 sm:p-8">
      <h2 class="text-xl font-bold">Email is the current contact method</h2>
      <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">This site intentionally does not collect contact-form submissions. Use the domain mailbox configured for <strong class="text-[var(--color-text-primary)]">aicareerguide.xyz</strong> and include the page URL plus the issue or proposal.</p>
      <div class="mt-6 rounded-xl border border-dashed border-[var(--color-border)] bg-[var(--color-bg)] p-5 text-sm leading-6 text-[var(--color-text-secondary)]"><strong class="text-[var(--color-text-primary)]">For corrections:</strong> include the exact URL, the incorrect statement, and a reliable source when possible.<br/><strong class="text-[var(--color-text-primary)]">For collaborations:</strong> explain the proposed project, audience, and intended outcome.</div>
    </div>
  </div>
</BaseLayout>
