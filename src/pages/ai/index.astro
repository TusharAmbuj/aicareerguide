---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ArticleCard from "@/components/cards/ArticleCard.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const posts = await getCollection(
  "blog",
  ({ data }) => !data.draft && data.status === "published",
);
const aiPosts = posts
  .filter((post) => post.data.category === "AI")
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const normalize = (value: string) =>
  value.toLowerCase().trim().replace(/\s+/g, "-");

const topics = [
  {
    slug: "machine-learning",
    name: "Machine Learning",
    number: "01",
    icon: "ML",
    description:
      "Build the core ideas: data, regression, classification, evaluation, features, and generalization.",
    focus: "Algorithms · Data · Evaluation",
    aliases: ["machine-learning", "machine learning", "ml"],
  },
  {
    slug: "deep-learning",
    name: "Deep Learning",
    number: "02",
    icon: "DL",
    description:
      "Move into neural networks, training, PyTorch, CNNs, transformers, and representation learning.",
    focus: "Neural Networks · PyTorch · Transformers",
    aliases: ["deep-learning", "deep learning", "dl"],
  },
  {
    slug: "generative-ai",
    name: "Generative AI",
    number: "03",
    icon: "Gen",
    description:
      "Learn how modern generative systems work and how to build useful applications around them.",
    focus: "Generation · RAG · Agents",
    aliases: [
      "generative-ai",
      "generative ai",
      "gen-ai",
      "generative artificial intelligence",
    ],
  },
  {
    slug: "llms",
    name: "Large Language Models",
    number: "04",
    icon: "LLM",
    description:
      "Understand tokens, attention, embeddings, inference, evaluation, fine-tuning, and production use.",
    focus: "LLMs · RAG · Evaluation",
    aliases: [
      "llm",
      "llms",
      "large-language-model",
      "large language model",
      "large language models",
    ],
  },
  {
    slug: "ai-engineering",
    name: "AI Engineering",
    number: "05",
    icon: "AI",
    description:
      "Turn models into reliable software with APIs, deployment, observability, security, and MLOps.",
    focus: "Systems · Deployment · MLOps",
    aliases: ["ai-engineering", "ai engineering"],
  },
];

const topicStats = topics.map((topic) => ({
  ...topic,
  count: aiPosts.filter((post) => {
    const aliases = topic.aliases.map(normalize);
    return (
      aliases.includes(normalize(post.data.primaryTopic)) ||
      post.data.topics.some((item) => aliases.includes(normalize(item)))
    );
  }).length,
}));

const featuredPost = aiPosts.find((post) => post.data.featured) ?? aiPosts[0];
const latestPosts = aiPosts.filter((post) => post !== featuredPost).slice(0, 4);
const breadcrumbItems = [
  { label: "Home", url: "/" },
  { label: "Learn", url: "/ai" },
];
---

<BaseLayout
  title="Learn AI | AI Career Guide"
  description="A practical, structured path through artificial intelligence, machine learning, deep learning, LLMs, and AI engineering."
  breadcrumbs={breadcrumbItems}
>
  <div class="ai-hub-page ai-explore-page">
    <section class="ai-learn-hero">
      <div class="content-container ai-learn-hero-inner">
        <Breadcrumbs items={breadcrumbItems} />
        <div class="ai-learn-hero-grid">
          <div class="ai-learn-copy">
            <span class="ai-learn-eyebrow">Learn · Build · Prove</span>
            <h1>Learn AI without getting lost in the noise.</h1>
            <p>
              Follow a practical sequence from fundamentals to modern AI
              systems. Understand the concepts, build real things, and know what
              you should be able to prove next.
            </p>
            <div class="ai-learn-actions">
              <a href="#ai-learning-path" class="button-primary"
                >Start the AI path <span aria-hidden="true">→</span></a
              >
              <a href="/careers/ai-engineer/" class="button-secondary"
                >Open AI Engineer roadmap</a
              >
            </div>
            <div
              class="ai-learn-metrics"
              aria-label="AI learning hub statistics"
            >
              <div><strong>{aiPosts.length}</strong><span>AI guides</span></div>
              <div>
                <strong>{topicStats.filter((t) => t.count > 0).length}</strong
                ><span>Active areas</span>
              </div>
              <div><strong>5</strong><span>Learning stages</span></div>
            </div>
          </div>
          <div class="ai-learn-orbit" aria-label="Explore AI learning topics">
            <div class="ai-orbit-core"><span>AI</span></div>
            <a
              class="ai-orbit-tag ai-orbit-tag-link ai-orbit-1"
              href="/ai/machine-learning/">Machine Learning</a
            >
            <a
              class="ai-orbit-tag ai-orbit-tag-link ai-orbit-2"
              href="/ai/deep-learning/">Deep Learning</a
            >
            <a
              class="ai-orbit-tag ai-orbit-tag-link ai-orbit-3"
              href="/ai/llms/">LLMs</a
            >
            <a
              class="ai-orbit-tag ai-orbit-tag-link ai-orbit-4"
              href="/ai/llms/">RAG</a
            >
            <a
              class="ai-orbit-tag ai-orbit-tag-link ai-orbit-5"
              href="/ai/ai-engineering/">AI Engineering</a
            >
            <a
              class="ai-orbit-tag ai-orbit-tag-link ai-orbit-6"
              href="/ai/ai-engineering/">MLOps</a
            >
          </div>
        </div>
      </div>
    </section>

    <div class="content-container ai-learn-body">
      <section id="ai-learning-path" class="ai-learning-path">
        <div class="ai-section-head">
          <div>
            <p class="section-kicker">The learning path</p>
            <h2 class="section-title">From fundamentals to production AI.</h2>
          </div>
          <p class="section-copy">
            Use the sequence when you're starting from scratch. Jump into a
            topic directly when you already have the foundations.
          </p>
        </div>
        <div class="ai-stage-list">
          {
            topicStats.map((topic, index) => (
              <a
                href={`/ai/${topic.slug}/`}
                class:list={[
                  "ai-stage-card",
                  topic.count === 0 && "ai-stage-card-muted",
                ]}
              >
                <div class="ai-stage-number">{topic.number}</div>
                <div class="ai-stage-main">
                  <div class="ai-stage-topline">
                    <>
                      <span class="ai-stage-icon">{topic.icon}</span>
                      <span>
                        {topic.count ? `${topic.count} guides` : "More coming"}
                      </span>
                    </>
                  </div>
                  <h3>{topic.name}</h3>
                  <p>{topic.description}</p>
                  <span class="ai-stage-focus">{topic.focus}</span>
                </div>
                <span class="ai-stage-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          }
        </div>
      </section>

      {
        featuredPost && (
          <section class="ai-feature-section">
            <div class="ai-section-head">
              <div>
                <>
                  <p class="section-kicker">Start here</p>
                  <h2 class="section-title">
                    One strong foundation beats twenty random tabs.
                  </h2>
                </>
              </div>
              <a href="/blog/" class="section-link">
                Browse the full library →
              </a>
            </div>
            <article class="ai-feature-card">
              <div class="ai-feature-copy">
                <div class="ai-feature-meta">
                  <>
                    <span>{featuredPost.data.primaryTopic}</span>
                    <span>
                      {featuredPost.data.readingTime
                        ? `${featuredPost.data.readingTime} min read`
                        : "Guide"}
                    </span>
                  </>
                </div>
                <h3>{featuredPost.data.title}</h3>
                <p>{featuredPost.data.description}</p>
                <div class="ai-feature-checks">
                  <>
                    <span>Clear mental models</span>
                    <span>Practical implementation</span>
                    <span>Next-step guidance</span>
                  </>
                </div>
                <a href={`/blog/${featuredPost.id}/`} class="button-primary">
                  Read the guide →
                </a>
              </div>
              <a
                class="ai-feature-media"
                href={`/blog/${featuredPost.id}/`}
                aria-label={`Read ${featuredPost.data.title}`}
              >
                {featuredPost.data.image ? (
                  <Image
                    src={featuredPost.data.image}
                    alt={featuredPost.data.imageAlt || featuredPost.data.title}
                    width={1200}
                    height={630}
                    widths={[640, 960, 1200]}
                    sizes="(min-width:1024px) 52vw, 100vw"
                    quality={84}
                    loading="lazy"
                  />
                ) : (
                  <div class="ai-feature-placeholder">AI</div>
                )}
              </a>
            </article>
          </section>
        )
      }

      <section class="ai-topic-grid-section">
        <div class="ai-section-head">
          <div>
            <p class="section-kicker">Explore by topic</p><h2
              class="section-title"
            >
              Choose depth, not just breadth.
            </h2>
          </div><p class="section-copy">
            Each topic connects explanations with the next thing you should
            learn or build.
          </p>
        </div>
        <div class="ai-topic-grid">
          {
            topicStats.map((topic) => (
              <a href={`/ai/${topic.slug}/`} class="ai-topic-card">
                <div class="ai-topic-card-top">
                  <>
                    <span class="ai-stage-icon">{topic.icon}</span>
                    <span>{topic.count} guides</span>
                  </>
                </div>
                <h3>{topic.name}</h3>
                <p>{topic.description}</p>
                <span class="ai-topic-card-link">
                  Explore topic <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="ai-build-strip">
        <div>
          <p class="section-kicker">Don't stop at reading</p>
          <h2>Turn every concept into proof.</h2>
          <p>
            When you understand something, build it. When you build it, evaluate
            it. When you can explain the result, you have evidence.
          </p>
        </div>
        <div class="ai-build-actions">
          <a href="/projects/" class="button-primary">Explore projects →</a><a
            href="/careers/"
            class="button-secondary">Explore roadmaps</a>
        </div>
      </section>

      {
        latestPosts.length > 0 && (
          <section class="ai-latest-section">
            <div class="ai-section-head">
              <>
                <div>
                  <>
                    <p class="section-kicker">Continue learning</p>
                    <h2 class="section-title">Latest AI guides.</h2>
                  </>
                </div>
                <a href="/blog/" class="section-link">
                  View all articles →
                </a>
              </>
            </div>
            <div class="ai-latest-grid">
              {latestPosts.map((post) => (
                <ArticleCard post={post} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>
