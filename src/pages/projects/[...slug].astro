---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import InternalLinks from '@/components/InternalLinks.astro';
import {getCollection, render} from 'astro:content';
export async function getStaticPaths(){const projects=await getCollection('projects',({data})=>!data.draft&&data.status==='published');return projects.map(project=>({params:{slug:project.id},props:{project}}))}
const {project}=Astro.props; const {Content}=await render(project); const d=project.data;
const all=await getCollection('projects',({data})=>!data.draft&&data.status==='published');
const related=all.filter(x=>x.id!==project.id && x.data.category===d.category).slice(0,3);
const breadcrumbs=[{label:'Home',url:'/'},{label:'Projects',url:'/projects'},{label:d.title,url:`/projects/${project.id}`}];
const evidence=[
  ['01','Understand','Define the problem, users, constraints, and success metric before implementation.'],
  ['02','Engineer','Build a small working baseline, then add architecture deliberately.'],
  ['03','Evaluate','Measure quality and failure modes; document what changed and why.'],
  ['04','Prove','Publish the repo, demo, architecture, result, and a concise resume story.']
];
---
<BaseLayout title={`${d.title}: Project Guide, Stack & Architecture`} description={d.description} image={d.image} breadcrumbs={breadcrumbs}>
  <div class="project-detail-page"><div class="content-container py-8 sm:py-12"><Breadcrumbs items={breadcrumbs}/>
    <section class="project-detail-hero-v2 mt-5">
      <div>
        <div class="flex flex-wrap gap-2"><span class="pill">{d.category}</span><span class="pill">{d.difficulty}</span><span class="pill">{d.timeToBuild}</span>{d.resumeValue==='High'&&<span class="pill">High portfolio value</span>}</div>
        <h1>{d.title}</h1>
        <p>{d.description}</p>
        <div class="mt-6 flex flex-wrap gap-2">{d.techStack.map(t=><span class="tag">{t}</span>)}</div>
        <div class="mt-7 flex flex-wrap gap-3">{d.githubUrl&&<a href={d.githubUrl} target="_blank" rel="noopener noreferrer" class="button-secondary">View GitHub ↗</a>}{d.demoUrl&&<a href={d.demoUrl} target="_blank" rel="noopener noreferrer" class="button-primary">Open live demo ↗</a>}</div>
      </div>
      <aside class="project-detail-aside">
        <div class="project-detail-score"><div><strong>{d.resumeValue}</strong><span>portfolio value</span></div><span>{d.category} track</span></div>
        <div class="project-detail-metrics"><div><span>Build</span><strong>{d.timeToBuild}</strong></div><div><span>Cost</span><strong>{d.estimatedCost||'Depends on stack'}</strong></div><div><span>Deploy</span><strong>{d.deployment.join(' · ')||'Choose a target'}</strong></div><div><span>Level</span><strong>{d.difficulty}</strong></div></div>
      </aside>
    </section>
    <nav class="project-detail-tabs" aria-label="Project sections"><a href="#overview">Overview</a><a href="#skills">Skills</a><a href="#workflow">Workflow</a><a href="#guide">Implementation</a><a href="#portfolio">Portfolio proof</a></nav>

    <section id="overview" class="mt-10"><div class="section-head-row"><div><p class="section-kicker">Project intelligence</p><h2 class="section-title">Know what you are building before you code.</h2></div></div><div class="project-meta-grid mt-6"><section><span>Prerequisites</span><div>{d.prerequisites.length?d.prerequisites.map(x=><span class="tag">{x}</span>):<em>Start from the listed stack.</em>}</div></section><section id="skills"><span>Skills you prove</span><div>{d.skills.length?d.skills.slice(0,10).map(x=><span class="tag">{x}</span>):<em>Covered in the guide.</em>}</div></section><section><span>Interview topics</span><div>{d.interviewTopics.length?d.interviewTopics.map(x=><span class="tag">{x}</span>):<em>Project deep-dive topics.</em>}</div></section></div></section>

    <section id="workflow" class="mt-12"><div class="section-head-row"><div><p class="section-kicker">Execution model</p><h2 class="section-title">Build → evaluate → document.</h2><p class="section-copy">A portfolio project should demonstrate engineering judgment, not only that a framework ran.</p></div></div><div class="project-evidence-grid mt-6">{evidence.map(([num,title,text])=><div><span>{num}</span><strong>{title}</strong><p>{text}</p></div>)}</div></section>

    <div id="guide" class="project-content-layout-v2 mt-12">
      <article class="project-guide-card-v2"><div class="content-prose prose prose-lg"><Content/></div></article>
      <aside class="project-sidebar-v2">
        <section><h3>What you will learn</h3><ul>{d.learningOutcomes.map(x=><li>✓ {x}</li>)}</ul></section>
        <section id="portfolio"><h3>Portfolio proof</h3><p class="mt-2">Explain the problem, architecture, implementation, evaluation, and measurable result. Avoid a technology-only bullet.</p></section>
        <section><h3>Next move</h3><p class="mt-2">Turn this project into portfolio evidence, then choose the next roadmap checkpoint.</p><a href="/careers/ai-engineer/" class="button-primary w-full mt-3">Open a roadmap</a></section>
      </aside>
    </div>

    {related.length>0&&<section class="mt-14"><div class="section-head-row"><div><p class="section-kicker">More like this</p><h2 class="section-title">Keep the project difficulty moving upward.</h2></div></div><div class="modern-project-grid mt-6">{related.map(x=><a href={`/projects/${x.id}/`} class="modern-project-detail-card"><div class="card-topline"><span class="pill">{x.data.category}</span><span>{x.data.difficulty}</span></div><h3>{x.data.title}</h3><p>{x.data.description}</p><div class="card-tags">{x.data.techStack.slice(0,4).map(t=><span class="tag">{t}</span>)}</div><span class="card-link">Open project →</span></a>)}</div></section>}
    <InternalLinks title="Connect this build to your career path" links={[{href:'/careers/ai-engineer/',label:'AI Engineer Roadmap',description:'Follow the broader skill sequence that turns projects into career evidence.',type:'Roadmap'},{href:'/projects/',label:'More Portfolio Projects',description:'Find another project to extend your technical evidence.',type:'Projects'}]}/>
  </div></div>
</BaseLayout>
