---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { getCollection } from "astro:content";
const roadmaps = (
  await getCollection("roadmaps", ({ data }) => !data.draft && data.status === "published")
).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const featured = roadmaps.find((r) => r.data.featured) || roadmaps[0];
const roadmapMeta = (slug) =>
  ({
    "ai-engineer": { label: "AI Systems", icon: "AI", description: "Software, ML, LLMs, and production AI." },
    "ml-engineer": { label: "Machine Learning", icon: "ML", description: "Statistics, modeling, evaluation, and production ML." },
    "software-engineer": { label: "Software Engineering", icon: "SE", description: "Programming, DSA, systems, backend, and delivery." },
    "dsa-mastery": { label: "Algorithms", icon: "DSA", description: "Data structures, patterns, algorithms, and practice." },
    internships: { label: "Career", icon: "JOB", description: "Prepare skills, projects, applications, and interviews." },
    interviews: { label: "Interview", icon: "INT", description: "Coding, technical depth, systems, and communication." },
  })[slug] || { label: "Roadmap", icon: "MAP", description: "A structured path from fundamentals to practice." };
---

<BaseLayout
  title="AI & Technology Roadmaps"
  description="Interactive learning and career roadmaps for AI engineering, machine learning, software engineering, DSA, internships, and technical interviews."
>
  <main class="roadmaps-page roadmaps-v8-index max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <header class="roadmaps-v8-index-hero">
      <div>
        <span>Learn · Build · Prove</span>
        <h1>Choose a path. Follow the map.</h1>
        <p>Interactive roadmaps that turn skills into projects and projects into evidence.</p>
      </div>
      {featured && (
        <a href={`/careers/${featured.id}/`} class="roadmaps-v8-featured">
          <div class="roadmaps-v8-featured-top">
            <span>Featured</span>
            <span>{featured.data.estimatedTime}</span>
          </div>
          <strong>{featured.data.title.replace(" Roadmap", "")}</strong>
          <p>{featured.data.description}</p>
          <span class="roadmaps-v8-featured-cta">Open interactive roadmap →</span>
        </a>
      )}
    </header>

    <section class="roadmaps-v8-index-tools" aria-label="Roadmap filters">
      <div>
        <span>Roadmaps</span>
        <strong>{roadmaps.length} paths</strong>
      </div>
      <div id="roadmap-filters" class="roadmaps-v8-index-filters">
        <button class="roadmap-filter active-filter" data-filter-group="category" data-filter-value="All">All</button>
        <button class="roadmap-filter" data-filter-group="category" data-filter-value="Engineering">Engineering</button>
        <button class="roadmap-filter" data-filter-group="category" data-filter-value="Algorithms">Algorithms</button>
        <button class="roadmap-filter" data-filter-group="category" data-filter-value="Career">Career</button>
      </div>
    </section>

    <section id="roadmap-grid" class="roadmaps-v8-grid">
      {roadmaps.map((roadmap) => {
        const meta = roadmapMeta(roadmap.id);
        return (
          <a
            href={`/careers/${roadmap.id}/`}
            class="roadmaps-v8-card roadmap-card"
            data-filter-item
            data-filter-category={roadmap.data.category}
          >
            <div class="roadmaps-v8-card-top">
              <span class="roadmap-icon">{meta.icon}</span>
              <span class="roadmaps-v8-card-time">{roadmap.data.estimatedTime}</span>
            </div>
            <span class="roadmaps-v8-card-label">{meta.label}</span>
            <h2>{roadmap.data.title.replace(" Roadmap", "")}</h2>
            <p>{meta.description}</p>
            <div class="roadmaps-v8-card-bottom">
              <span>{roadmap.data.difficulty}</span>
              <span>Open map →</span>
            </div>
          </a>
        );
      })}
    </section>
  </main>
</BaseLayout>
