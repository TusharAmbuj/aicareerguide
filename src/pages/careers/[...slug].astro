---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";
import { getCollection, render } from "astro:content";
import { getRoadmapVisual } from "@/data/roadmaps";

export async function getStaticPaths() {
  const roadmaps = await getCollection(
    "roadmaps",
    ({ data }) => !data.draft && data.status === "published",
  );
  return roadmaps.map((roadmap) => ({
    params: { slug: roadmap.id },
    props: { roadmap },
  }));
}

const { roadmap } = Astro.props;
const visual = getRoadmapVisual(roadmap.id);
if (!visual) throw new Error(`Missing visual roadmap definition for ${roadmap.id}`);
const { Content } = await render(roadmap);
const breadcrumbs = [
  { label: "Home", url: "/" },
  { label: "Roadmaps", url: "/careers" },
  { label: roadmap.data.title.replace(" Roadmap", ""), url: `/careers/${roadmap.id}` },
];
const allNodes = visual.phases.flatMap((phase) => phase.nodes);
---

<BaseLayout
  title={`${roadmap.data.title} | AI Career Guide`}
  description={roadmap.data.description}
  image={roadmap.data.image}
  breadcrumbs={breadcrumbs}
>
  <main
    class="roadmap-v8-page roadmap-detail-shell"
    data-roadmap-slug={roadmap.id}
  >
    <div class="roadmap-v8-wrap">
      <Breadcrumbs items={breadcrumbs} />

      <header class="roadmap-v8-header" aria-labelledby="roadmap-title">
        <div class="roadmap-v8-header-copy">
          <div class="roadmap-v8-meta">
            <span>{roadmap.data.category}</span>
            <span>{roadmap.data.difficulty}</span>
            <span>{roadmap.data.estimatedTime}</span>
          </div>
          <h1 id="roadmap-title">{roadmap.data.title.replace(" Roadmap", "")}</h1>
          <p>{visual.tagline}</p>
          <div class="roadmap-v8-actions">
            <button id="continue-btn" class="button-primary" type="button">
              Continue <span aria-hidden="true">→</span>
            </button>
            <a href="/projects/" class="button-secondary">Projects <span aria-hidden="true">↗</span></a>
            <button id="reset-progress" class="roadmap-v8-reset" type="button">Reset</button>
          </div>
        </div>

        <section class="roadmap-v8-progress" aria-label="Your roadmap progress">
          <div class="roadmap-v8-progress-head">
            <div>
              <span>Progress</span>
              <strong id="progress-percent">0%</strong>
            </div>
            <div
              class="roadmap-v2-ring roadmap-v8-ring"
              role="progressbar"
              aria-label="Roadmap completion"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
            >
              <span id="progress-ring-value">0%</span>
            </div>
          </div>
          <div class="roadmap-v8-progress-track">
            <div id="progress-bar" class="roadmap-v8-progress-fill" style="width:0%"></div>
          </div>
          <div class="roadmap-v8-progress-meta">
            <span id="progress-count">0 / {allNodes.length}</span>
            <span>{visual.phases.length} phases</span>
          </div>
          <p id="progress-message">Start with Phase 01.</p>
        </section>
      </header>

      <nav class="roadmap-v8-phase-nav" id="phase-nav" aria-label="Roadmap phases">
        {visual.phases.map((phase) => (
          <a href={`#${phase.id}`} class="roadmap-v8-phase-link phase-nav-item">
            <span>{phase.number}</span>
            <strong>{phase.title}</strong>
          </a>
        ))}
      </nav>

      <section class="roadmap-v8-toolbar" aria-label="Roadmap controls">
        <div>
          <span class="roadmap-v8-toolbar-label">Learn in order</span>
          <strong id="roadmap-mode-label">All topics</strong>
        </div>
        <div class="roadmap-v8-toolbar-controls">
          <div class="roadmap-v8-segmented" role="group" aria-label="Filter checkpoints">
            <button type="button" class="roadmap-view-btn active-filter" data-view="all" aria-pressed="true">All</button>
            <button type="button" class="roadmap-view-btn" data-view="core" aria-pressed="false">Core</button>
            <button type="button" class="roadmap-view-btn" data-view="project" aria-pressed="false">Build</button>
            <button type="button" class="roadmap-view-btn" data-view="career" aria-pressed="false">Career</button>
          </div>
          <label class="roadmap-v8-jump" for="phase-jump">
            <span>Jump to</span>
            <select id="phase-jump">
              <option value="">Phase…</option>
              {visual.phases.map((phase) => (
                <option value={phase.id}>{phase.number} · {phase.title}</option>
              ))}
            </select>
          </label>
          <button type="button" id="focus-toggle" class="roadmap-v8-focus" aria-pressed="false">Focus</button>
        </div>
      </section>

      <section class="roadmap-v8-map" aria-label={`${roadmap.data.title} interactive roadmap`}>
        <div class="roadmap-v8-spine" aria-hidden="true"></div>
        {visual.phases.map((phase, phaseIndex) => (
          <article id={phase.id} class="roadmap-phase roadmap-v8-phase" data-phase-index={phaseIndex}>
            <header class="roadmap-v8-phase-head">
              <div class="roadmap-v8-phase-marker" aria-hidden="true">{phase.number}</div>
              <div class="roadmap-v8-phase-title">
                <span>Phase {phase.number}</span>
                <h2>{phase.title}</h2>
                <p>{phase.subtitle}</p>
              </div>
              <div class="roadmap-v8-phase-goal">
                <span>Goal</span>
                <p>{phase.goal}</p>
                <div class="roadmap-phase-progress" aria-label={`${phase.title} progress`}>
                  <div class="roadmap-phase-progress-track"><span class="roadmap-phase-progress-fill"></span></div>
                  <span class="roadmap-phase-progress-label">0%</span>
                </div>
              </div>
            </header>

            <div class="roadmap-v8-node-grid roadmap-node-grid">
              {phase.nodes.map((node, nodeIndex) => (
                <button
                  type="button"
                  class:list={[
                    "roadmap-node",
                    "roadmap-v8-node",
                    node.type === "project" && "is-project",
                    node.type === "career" && "is-career",
                    node.type === "optional" && "is-optional",
                  ]}
                  aria-pressed="false"
                  aria-label={`Open roadmap checkpoint: ${node.title}`}
                  data-node-id={node.id}
                  data-node-type={node.type ?? "core"}
                  data-node-title={node.title}
                  data-node-description={node.description}
                  data-node-tags={JSON.stringify(node.tags ?? [])}
                  data-node-links={JSON.stringify(node.links ?? [])}
                  data-node-prereqs={JSON.stringify(node.prerequisites ?? [])}
                >
                  <span class="roadmap-v8-node-top">
                    <span class="roadmap-v8-node-number">{String(nodeIndex + 1).padStart(2, "0")}</span>
                    <span class="roadmap-v8-node-type">
                      {node.type === "project" ? "Build" : node.type === "career" ? "Career" : node.type === "optional" ? "Optional" : "Core"}
                    </span>
                  </span>
                  <span class="roadmap-v8-node-title">{node.title}</span>
                  {node.short && <span class="roadmap-v8-node-short">{node.short}</span>}
                  <span class="roadmap-v8-node-footer">
                    <span>Open checkpoint</span>
                    <span class="roadmap-v8-node-arrow" aria-hidden="true">↗</span>
                  </span>
                  <span class="roadmap-v8-complete" aria-hidden="true">✓</span>
                </button>
              ))}
            </div>
          </article>
        ))}
      </section>

      <section class="roadmap-v8-how" id="guide">
        <div>
          <span>How to use it</span>
          <h2>Learn → build → prove.</h2>
        </div>
        <div class="roadmap-v8-how-grid">
          <div><strong>01</strong><p>Follow the phases in order. Open a checkpoint when you're ready to dive deeper.</p></div>
          <div><strong>02</strong><p>Use the build checkpoints to turn concepts into working projects.</p></div>
          <div><strong>03</strong><p>Mark progress locally and use the final phase to turn learning into evidence.</p></div>
        </div>
      </section>

      <details class="roadmap-v8-notes">
        <summary>Roadmap notes <span>Read the reasoning behind the sequence</span></summary>
        <div class="roadmap-v8-notes-content prose">
          <Content />
        </div>
      </details>
    </div>
  </main>

  <div id="roadmap-modal" class="roadmap-modal" role="dialog" aria-modal="true" aria-labelledby="roadmap-modal-title" hidden>
    <div class="roadmap-modal-backdrop" data-close-modal></div>
    <div class="roadmap-modal-panel roadmap-v8-modal-panel">
      <div class="roadmap-v8-modal-head">
        <div>
          <span id="roadmap-modal-kicker" class="roadmap-v8-modal-kicker">Checkpoint</span>
          <h2 id="roadmap-modal-title">Topic</h2>
        </div>
        <button type="button" id="roadmap-modal-close" class="roadmap-v8-close" aria-label="Close">×</button>
      </div>
      <p id="roadmap-modal-description" class="roadmap-v8-modal-description"></p>
      <div id="roadmap-modal-tags" class="roadmap-v8-modal-tags"></div>
      <div id="roadmap-modal-prereqs"></div>
      <div id="roadmap-modal-links" class="roadmap-v8-modal-links"></div>
      <div class="roadmap-v8-modal-actions">
        <button type="button" id="roadmap-complete-btn" class="button-primary">Mark complete</button>
        <button type="button" data-close-modal class="button-secondary">Close</button>
      </div>
    </div>
  </div>
</BaseLayout>
