---
import { getReadingTime } from "@/lib/content";
import { Image } from "astro:assets";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import CollectionHero from "@/components/common/CollectionHero.astro";
import ArticleCard from "@/components/cards/ArticleCard.astro";
import { getCollection } from "astro:content";
const posts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.status === "published",
  )
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = posts.find((x) => x.data.featured) || posts[0];
const rest = featured ? posts.filter((x) => x.id !== featured.id) : posts;
const cats = ["All", ...Array.from(new Set(posts.map((x) => x.data.category)))];
const types = [
  "All",
  ...Array.from(new Set(posts.map((x) => x.data.contentType))),
];
---

<BaseLayout
  title="AI, Machine Learning & Career Blog"
  description="People-first technical guides on AI, machine learning, LLMs, software engineering, projects, and AI careers."
  ><div class="blog-page-shell blog-v11-page content-container pb-10 sm:pb-14">
    <CollectionHero
      eyebrow="AI Career Guide · Journal"
      title="Practical AI & engineering guides."
      description="Clear technical guides, career roadmaps, and project-focused explanations for people learning to build with AI."
      stats={[
        {
          value: String(posts.length),
          label: "Guides",
          detail: "Published technical articles",
        },
        {
          value: "AI-first",
          label: "Focus",
          detail: "Practical, career-oriented content",
        },
        {
          value: "Reviewed",
          label: "Quality",
          detail: "Editorial freshness metadata",
        },
      ]}
      actions={[
        { label: "Explore roadmaps", href: "/careers/" },
        { label: "Explore projects", href: "/projects/", kind: "secondary" },
      ]}
    />{
      featured && (
        <section class="mt-10">
          <>
            <div class="v9-section-head">
        <div><p class="section-kicker">Featured</p><h2>Start here</h2></div>
      </div>
            <a href={`/blog/${featured.id}/`} class="blog-feature-card mt-6">
              <>
                <div>
                  <>
                    <div class="flex flex-wrap gap-2">
                      <>
                        <span class="pill">{featured.data.category}</span>
                        <span class="pill">{featured.data.contentType}</span>
                        <span class="pill">
                          {getReadingTime(
                            featured.body,
                            featured.data.readingTime,
                          )}{" "}
                          min read
                        </span>
                      </>
                    </div>
                    <h2>{featured.data.title}</h2>
                    <p>{featured.data.description}</p>

                    <span class="card-link mt-6 inline-flex">Read guide →</span>
                  </>
                </div>
                <div class="blog-feature-image">
                  {featured.data.image && (
                    <Image
                      src={featured.data.image}
                      alt={featured.data.imageAlt || `Featured image for ${featured.data.title}`}
                      width={1200}
                      widths={[640, 960, 1200]}
                      sizes="(min-width:1024px) 55vw,100vw"
                      quality={82}
                      loading="eager"
                      fetchpriority="high"
                      decoding="async"
                    />
                  )}
                </div>
              </>
            </a>
          </>
        </section>
      )
    }
    <section
      class="blog-library mt-12"
      data-filter-root
      data-filter-count-label="article"
      data-filter-sync-url
    >
      <div class="blog-filter-bar">
        <div class="blog-search-primary">
          <label class="blog-search-field">
            <span class="sr-only">Search articles</span>
            <span class="blog-search-icon" aria-hidden="true">⌕</span>
            <input
              id="blog-search"
              data-filter-search
              type="search"
              placeholder="Search guides, AI topics, careers, projects…"
              autocomplete="off"
            />
            <kbd>⌘K</kbd>
          </label>
          <button type="button" data-filter-clear class="blog-filter-clear">Clear</button>
        </div>
        <div class="blog-filter-row">
          <div
            class="filter-scroll"
            role="group"
            aria-label="Filter by category"
          >
            {
              cats.map((c, i) => (
                <button
                  type="button"
                  class:list={["blog-filter-btn", i === 0 && "active"]}
                  data-filter-group="category"
                  data-filter-value={c}
                  aria-pressed={i === 0}
                >
                  {c}
                </button>
              ))
            }
          </div><div
            class="filter-scroll"
            role="group"
            aria-label="Filter by content type"
          >
            {
              types.map((t, i) => (
                <button
                  type="button"
                  class:list={["blog-filter-btn", i === 0 && "active"]}
                  data-filter-group="type"
                  data-filter-value={t}
                  aria-pressed={i === 0}
                >
                  {t}
                </button>
              ))
            }
          </div><label class="blog-search-wrap"
            ><span class="sr-only">Search articles</span><input
              id="blog-search"
              data-filter-search
              type="search"
              placeholder="Search articles…"
              autocomplete="off"
            /></label
          ><button
            type="button"
            id="blog-filter-clear"
            data-filter-clear
            class="blog-filter-clear"
            aria-label="Clear article filters">Clear</button
          >
        </div>
      </div><div class="home-section-head mt-8">
        <div>
          <p class="section-kicker">Library</p><h2 class="section-title">
            Browse the knowledge base.
          </h2>
        </div><span
          id="blog-count"
          data-filter-count
          class="blog-result-count"
          aria-live="polite"
          >{rest.length} articles</span
        >
      </div><p class="blog-filter-hint" id="blog-filter-help">Search first, then narrow by topic or format.</p>
      <p class="hidden mt-5" data-filter-empty>
        No articles match these filters. Try a different topic or search term.
      </p><div id="blog-grid" class="article-grid mt-6" data-filter-items>
        {
          rest.map((x) => (
            <div
              data-filter-item
              data-filter-category={x.data.category}
              data-filter-type={x.data.contentType}
              data-filter-search-text={`${x.data.title} ${x.data.description} ${(x.data.tags || []).join(" ")} ${(x.data.topics || []).join(" ")}`.toLowerCase()}
            >
              <ArticleCard post={x} />
            </div>
          ))
        }
      </div><div
        id="blog-empty"
        class="hidden mt-8 empty-state"
        data-filter-empty
      >
        <strong>No articles match.</strong><p>
          Try a different keyword or clear the filters.
        </p>
      </div>
    </section>
  </div></BaseLayout
>
