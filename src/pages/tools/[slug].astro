---
import BaseLayout from '@/components/layout/BaseLayout.astro'; import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'; import {getCollection, render} from 'astro:content';
export async function getStaticPaths(){const tools=await getCollection('tools',({data})=>!data.draft&&data.status==='published');return tools.map(tool=>({params:{slug:tool.id},props:{tool}}))}
const {tool}=Astro.props; const {Content}=await render(tool); const d=tool.data; const bc=[{label:'Home',url:'/'},{label:'Tools',url:'/tools'},{label:d.name,url:`/tools/${tool.id}`}]; const verified=d.lastVerified?d.lastVerified.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}):'Editorial review';
---
<BaseLayout title={`${d.name}: Features, Pricing & Best Use Cases`} description={d.description} breadcrumbs={bc}><div class="content-container py-8 sm:py-12"><Breadcrumbs items={bc}/><section class="tool-detail-hero tool-detail-hero-modern mt-5"><div class="tool-detail-hero-grid"><div><div class="flex flex-wrap gap-2"><span class="pill">{d.category}</span><span class="pill">{d.pricing}</span>{d.recommendation&&<span class="pill">{d.recommendation}</span>}</div><div class="mt-6 flex items-start gap-4"><span class="tool-brand-mark">{d.name.slice(0,2).toUpperCase()}</span><div><h1>{d.name}</h1><p class="tool-detail-subtitle">{d.description}</p></div></div><div class="mt-6 flex flex-wrap gap-2">{d.tags.map(tag=><span class="tag">{tag}</span>)}</div><div class="mt-7 flex flex-wrap gap-3"><a href={d.url} target="_blank" rel="noopener noreferrer" class="button-primary">Visit official site ↗</a><a href="/tools/" class="button-secondary">Browse all tools</a></div></div><div class="tool-detail-aside-card"><p class="context-label">Quick verdict</p><p class="tool-verdict">{d.recommendation||'Curated'}</p><p class="mt-2 text-sm text-[var(--color-text-secondary)]">Useful for {d.bestFor.slice(0,2).join(' and ').toLowerCase()}.</p><div class="mt-6 space-y-3 text-sm"><div class="flex justify-between gap-4"><span class="text-[var(--color-text-muted)]">Pricing</span><strong>{d.pricing}</strong></div><div class="flex justify-between gap-4"><span class="text-[var(--color-text-muted)]">Verified</span><strong>{verified}</strong></div></div></div></div></section><div class="tool-detail-metrics mt-6"><div><span>Best for</span><strong>{d.bestFor[0]||'General use'}</strong></div><div><span>Category</span><strong>{d.category}</strong></div><div><span>Format</span><strong>Curated guide</strong></div><div><span>Official source</span><strong>Open ↗</strong></div></div><div class="tool-content-layout mt-10"><article class="tool-guide-card surface-card"><div class="content-prose prose prose-lg"><Content/></div></article><aside class="tool-guide-sidebar"><section class="surface-card p-5"><p class="context-label">Best for</p><div class="mt-3 flex flex-wrap gap-2">{d.bestFor.map(x=><span class="tag">{x}</span>)}</div></section><section class="surface-card p-5"><p class="context-label">Editorial note</p><p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">AI Career Guide prioritizes tools that fit a practical learning or building workflow instead of listing everything available.</p></section><a href={d.url} target="_blank" rel="noopener noreferrer" class="source-button w-full">Visit official site ↗</a></aside></div></div></BaseLayout>
