---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import CollectionHero from "@/components/common/CollectionHero.astro";
import { getCollection } from "astro:content";
const r = (
  await getCollection(
    "resources",
    ({ data }) => !data.draft && data.status === "published",
  )
).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const types = ["All", ...Array.from(new Set(r.map((x) => x.data.type)))];
---

<BaseLayout
  title="AI Learning Resources"
  description="Curated courses, books, datasets, APIs, and roadmaps for AI and software engineering."
  ><div
    class="resources-page content-container pb-10 sm:pb-14"
    data-filter-root
    data-filter-count-label="resource"
  >
    <CollectionHero
      eyebrow="Curated library"
      title="Fewer links. Better resources."
      description="Resources chosen for practical learning, with a dedicated page that explains what each resource is useful for."
      stats={[
        {
          value: String(r.length),
          label: "Resources",
          detail: "Selected learning material",
        },
        {
          value: String(types.length - 1),
          label: "Formats",
          detail: "Books, courses, APIs & more",
        },
        {
          value: "Useful",
          label: "Editorial goal",
          detail: "Context before recommendation",
        },
      ]}
      actions={[
        { label: "Explore roadmaps", href: "/careers/" },
        { label: "Browse tools", href: "/tools/", kind: "secondary" },
      ]}
    /><section
      class="resources-explore"
      aria-labelledby="resources-explore-title"
    >
      <div class="resources-explore-head">
        <div class="resources-explore-intro">
          <p class="section-kicker">Explore</p>
          <h2 id="resources-explore-title" class="section-title">
            Find the right resource for the next step.
          </h2>
          <p>
            Filter by format or search by title, topic, or tag. Every card leads
            to a page with context, strengths, limitations, and where it fits in
            your learning path.
          </p>
        </div>
        <span class="resources-result-count" data-filter-count
          >{r.length} resources</span
        >
      </div>
      <div
        class="resources-filter-bar"
        role="toolbar"
        aria-label="Resource filters"
      >
        <div
          class="resources-filter-scroller"
          role="group"
          aria-label="Filter by format"
        >
          {
            types.map((c, i) => (
              <button
                type="button"
                class:list={["blog-filter-btn", i === 0 && "active"]}
                data-filter-group="type"
                data-filter-value={c}
                aria-pressed={i === 0}
              >
                {c}
              </button>
            ))
          }
        </div>
        <label class="resources-search-wrap">
          <span class="sr-only">Search resources</span>
          <input
            data-filter-search
            type="search"
            placeholder="Search resources…"
            autocomplete="off"
          />
        </label>
        <button type="button" class="resources-filter-clear" data-filter-clear
          >Clear</button
        >
      </div>
      <div
        id="resource-grid"
        class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3"
      >
        {
          r.map((x) => (
            <a
              href={`/resources/${x.id}/`}
              data-filter-item
              data-filter-type={x.data.type}
              data-filter-search-text={`${x.data.title} ${x.data.description} ${(x.data.tags || []).join(" ")}`.toLowerCase()}
              class="surface-card surface-card-hover p-6 group"
            >
              <>
                <div class="flex justify-between gap-3">
                  <>
                    <span class="pill">{x.data.type}</span>
                    <span class="pill">{x.data.price}</span>
                  </>
                </div>
                <h3 class="mt-5 text-xl font-black group-hover:text-[var(--color-accent)]">
                  {x.data.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
                  {x.data.description}
                </p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {x.data.tags.slice(0, 3).map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </div>
                <div class="mt-6 border-t border-[var(--color-border)] pt-4 text-sm font-bold text-[var(--color-accent)]">
                  View resource details →
                </div>
              </>
            </a>
          ))
        }
      </div>
      <p class="hidden" data-filter-empty>
        No resources match these filters. Try another format or search term.
      </p>
    </section>
  </div></BaseLayout
>
