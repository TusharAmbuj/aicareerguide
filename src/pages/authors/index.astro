---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { AUTHORS } from '@/data/authors';
---
<BaseLayout title="Authors | AI Career Guide" description="Meet the authors and editorial profiles behind AI Career Guide.">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">People behind the work</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Authors</h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-[var(--color-text-secondary)]">Profiles, expertise, and published work from the people and organization contributing to AI Career Guide.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {Object.values(AUTHORS).map((author) => (
        <a href={author.url} class="rounded-2xl border border-[var(--color-border)] p-6 hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-secondary)]">
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-accent)] text-xl font-bold text-white">{author.name.charAt(0)}</div>
            <div>
              <h2 class="text-xl font-bold">{author.name}</h2>
              <p class="text-sm text-[var(--color-text-muted)]">{author.type}</p>
            </div>
          </div>
          <p class="mt-4 text-sm leading-6 text-[var(--color-text-secondary)]">{author.bio}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
