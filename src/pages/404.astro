---
import BaseLayout from "@/components/layout/BaseLayout.astro";
---
<BaseLayout noindex title="Page Not Found" description="The page you are looking for does not exist.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20"><div class="text-center"><p class="text-sm font-bold uppercase tracking-[0.18em] text-[var(--color-accent)]">404</p><h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">Page not found</h1><p class="mt-4 mx-auto max-w-xl text-lg leading-8 text-[var(--color-text-secondary)]">The URL may be outdated, the page may have moved, or the path may be incorrect.</p><div class="mt-7 flex flex-wrap justify-center gap-3"><a href="/" class="button-primary">Go home</a><a href="/search" class="button-secondary">Search the site</a></div></div><div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><a href="/ai" class="rounded-xl border border-[var(--color-border)] p-5 hover:border-[var(--color-accent)]"><h2 class="font-bold">Learn AI</h2><p class="mt-2 text-sm text-[var(--color-text-secondary)]">Core AI concepts and practical guides.</p></a><a href="/careers" class="rounded-xl border border-[var(--color-border)] p-5 hover:border-[var(--color-accent)]"><h2 class="font-bold">Career roadmaps</h2><p class="mt-2 text-sm text-[var(--color-text-secondary)]">Step-by-step role and skill roadmaps.</p></a><a href="/projects" class="rounded-xl border border-[var(--color-border)] p-5 hover:border-[var(--color-accent)]"><h2 class="font-bold">Projects</h2><p class="mt-2 text-sm text-[var(--color-text-secondary)]">Practical projects for your portfolio.</p></a><a href="/blog" class="rounded-xl border border-[var(--color-border)] p-5 hover:border-[var(--color-accent)]"><h2 class="font-bold">Blog</h2><p class="mt-2 text-sm text-[var(--color-text-secondary)]">Deep, practical technical articles.</p></a></div></div>
</BaseLayout>
