---
const { category } = Astro.props as {
  category: { name: string; href: string; icon?: string };
};
---

<a
  href={category.href}
  class="category-card-premium group p-5 text-center border border-[var(--color-border)] rounded-2xl text-[var(--color-text-primary)]"
>
  {category.icon && <span class="text-2xl block">{category.icon}</span>}
  <span class="font-medium">{category.name}</span>
</a>
