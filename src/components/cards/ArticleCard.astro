---
import { getReadingTime } from "@/lib/content";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { id, data } = post;
const displayReadingTime = getReadingTime(post.body, data.readingTime);
---

<a
  href={`/blog/${id}/`}
  class="article-card-premium group block h-full overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] transition-all"
>
  {
    data.image && (
      <Image
        src={data.image}
        alt={data.imageAlt || `Featured image for ${data.title}`}
        width={1200}
        height={630}
        widths={[480, 640, 960, 1200]}
        sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
        quality={80}
        loading="lazy"
        decoding="async"
        fetchpriority="low"
        class="article-card-image aspect-[1.91/1] w-full object-cover border-b border-[var(--color-border)]"
      />
    )
  }
  <div class="p-5">
    <div
      class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--color-accent)]"
    >
      <span>{data.category}</span>{
        data.topics?.[0] && (
          <>
            <>
              <span class="text-[var(--color-border)]">/</span>
              <span class="text-[var(--color-text-muted)]">
                {data.topics[0]}
              </span>
            </>
          </>
        )
      }
    </div>
    <h3
      class="mt-3 text-xl font-bold leading-snug text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)]"
    >
      {data.title}
    </h3>
    <p
      class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)] line-clamp-3"
    >
      {data.description}
    </p>
    <div
      class="mt-5 flex items-center gap-2 text-xs text-[var(--color-text-muted)]"
    >
      <time datetime={data.pubDate.toISOString()}
        >{
          data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }</time
      ><span>•</span><span>{displayReadingTime} min read</span>
    </div>
  </div>
</a>
