---
interface Stat { value: string; label: string; detail?: string; }
interface Action { label: string; href: string; kind?: "primary" | "secondary"; }
interface Props { eyebrow: string; title: string; description: string; stats?: Stat[]; actions?: Action[]; }
const { eyebrow, title, description, stats = [], actions = [] } = Astro.props;
---

<section class="collection-hero" aria-labelledby="collection-hero-title">
  <div class="collection-hero-inner content-container">
    <div class="collection-hero-copy">
      <span class="eyebrow">{eyebrow}</span>
      <h1 id="collection-hero-title">{title}</h1>
      <p>{description}</p>
      {actions.length > 0 && (
        <div class="collection-hero-actions">
          {actions.map((action) => (
            <a
              href={action.href}
              class={action.kind === "secondary" ? "button-secondary" : "button-primary"}
            >{action.label}<span aria-hidden="true">→</span></a>
          ))}
        </div>
      )}
    </div>
    {stats.length > 0 && (
      <div class="collection-hero-panel" aria-label="Section summary">
        <div class="collection-hero-stats">
          {stats.slice(0, 3).map((stat) => (
            <div class="collection-hero-stat">
              <div class="collection-hero-stat-content">
                <div class="collection-hero-stat-value">{stat.value}</div>
                <div class="collection-hero-stat-label">{stat.label}</div>
                {stat.detail && <div class="collection-hero-stat-detail">{stat.detail}</div>}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
