---
import ThemeToggle from "./ThemeToggle.astro";
import Search from "@/components/Search.astro";
import { Search as SearchIcon, Menu, X } from "@lucide/astro";

const nav = [
  { label: "Learn", href: "/ai/" },
  { label: "Roadmaps", href: "/careers/" },
  { label: "Projects", href: "/projects/" },
  { label: "Resources", href: "/resources/" },
  { label: "Tools", href: "/tools/" },
  { label: "Blog", href: "/blog/" },
];

const secondaryNav = [
  { label: "News", href: "/news/" },
  { label: "About", href: "/about/" },
];

const active = (href: string) => {
  const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
  const target = href.replace(/\/+$/, "") || "/";
  return (
    pathname === target || (target !== "/" && pathname.startsWith(`${target}/`))
  );
};
---

<header class="site-header">
  <div class="content-container site-header-inner">
    <a href="/" class="brand shrink-0" aria-label="AI Career Guide home">
      <img
        src="/logo.webp"
        width="40"
        height="40"
        class="brand-logo"
        alt=""
        aria-hidden="true"
      />
      <span class="brand-copy">
        <span class="brand-name">AI Career Guide</span>
        <span class="brand-subtitle">Learn · Build · Prove</span>
      </span>
    </a>

    <nav
      aria-label="Primary"
      class="site-primary-nav hidden xl:flex min-w-0 flex-1 items-center justify-end gap-0.5"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={active(item.href) ? "page" : undefined}
            class:list={["nav-link", active(item.href) && "nav-link-active"]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions shrink-0">
      <div class="header-search hidden 2xl:block">
        <Search instance="desktop" />
      </div>
      <a
        href="/search/"
        class="header-icon-btn header-search-button hidden xl:inline-flex 2xl:hidden"
        aria-label="Search"
      >
        <SearchIcon class="h-4.5 w-4.5" aria-hidden="true" />
      </a>
      <a href="/search/" class="header-icon-btn xl:hidden" aria-label="Search">
        <SearchIcon class="h-5 w-5" aria-hidden="true" />
      </a>
      <a
        href="/careers/ai-engineer/"
        class="header-start-cta hidden 2xl:inline-flex"
        >Start learning <span aria-hidden="true">→</span></a
      >
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="header-icon-btn xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        type="button"
      >
        <Menu id="mobile-menu-open" class="h-5 w-5" aria-hidden="true" />
        <X id="mobile-menu-close" class="hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav hidden xl:hidden">
    <div class="content-container mobile-nav-panel">
      <div class="mobile-search-wrap"><Search instance="mobile" /></div>
      <nav aria-label="Mobile" class="grid gap-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={active(item.href) ? "page" : undefined}
              class:list={[
                "mobile-nav-link",
                active(item.href) && "mobile-nav-link-active",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="mobile-more-links">
        {
          secondaryNav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "mobile-nav-link",
                active(item.href) && "mobile-nav-link-active",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <a href="/careers/ai-engineer/" class="mobile-nav-cta"
        >Start your journey <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
</header>

<script>
  const initHeader = () => {
    const button = document.getElementById(
      "mobile-menu-btn",
    ) as HTMLButtonElement | null;
    const nav = document.getElementById("mobile-nav");
    const openIcon = document.getElementById("mobile-menu-open");
    const closeIcon = document.getElementById("mobile-menu-close");
    if (!button || !nav || button.dataset.ready === "true") return;
    button.dataset.ready = "true";
    let lastFocused: HTMLElement | null = null;

    const setOpen = (open: boolean) => {
      nav.classList.toggle("hidden", !open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
      document.body.classList.toggle("mobile-menu-open", open);
    };
    const closeMenu = () => {
      setOpen(false);
      lastFocused?.focus({ preventScroll: true });
      lastFocused = null;
    };
    const openMenu = () => {
      lastFocused =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
      setOpen(true);
      requestAnimationFrame(() =>
        nav
          .querySelector<HTMLElement>("input, a, button")
          ?.focus({ preventScroll: true }),
      );
    };
    button.addEventListener("click", () =>
      button.getAttribute("aria-expanded") === "true"
        ? closeMenu()
        : openMenu(),
    );
    nav
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", closeMenu));
    const onKey = (event: KeyboardEvent) => {
      if (
        event.key === "Escape" &&
        button.getAttribute("aria-expanded") === "true"
      )
        closeMenu();
    };
    document.addEventListener("keydown", onKey);
    window.addEventListener(
      "resize",
      () => {
        if (
          window.innerWidth >= 1280 &&
          button.getAttribute("aria-expanded") === "true"
        )
          closeMenu();
      },
      { passive: true },
    );
  };
  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
