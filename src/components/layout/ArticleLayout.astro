---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import TableOfContents from "@/components/TableOfContents.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import AuthorBox from "@/components/AuthorBox.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";
import { getAuthorProfile } from "@/data/authors";
export interface Props {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    lastReviewed?: Date;
    sources?: { title: string; url: string }[];
    author: string;
    category: string;
    contentType?: string;
    tags?: string[];
    topics?: string[];
    difficulty?: "Beginner" | "Intermediate" | "Advanced";
    prerequisites?: string[];
    nextSteps?: string[];
    keyTakeaways?: string[];
    image?: any;
    imageAlt?: string;
    imageCaption?: string;
    readingTime?: number;
    headings: { depth: number; slug: string; text: string }[];
    relatedPosts?: any[];
    canonical?: string;
    articleType?: "BlogPosting" | "TechArticle";
    authorType?: "Organization" | "Person";
    previousPost?: any;
    nextPost?: any;
}
const {
    title,
    description,
    pubDate,
    updatedDate,
    lastReviewed,
    sources = [],
    author,
    category,
    contentType = "guide",
    tags = [],
    topics = [],
    difficulty = "Intermediate",
    prerequisites = [],
    nextSteps = [],
    keyTakeaways = [],
    image,
    imageAlt,
    imageCaption,
    readingTime = 8,
    headings = [],
    relatedPosts = [],
    canonical,
    previousPost,
    nextPost,
    articleType = "BlogPosting",
    authorType = "Organization",
} = Astro.props;
const authorProfile = getAuthorProfile(author);
const breadcrumbItems = [
    { label: "Home", url: "/" },
    { label: "Blog", url: "/blog" },
    { label: category, url: `/blog/?category=${encodeURIComponent(category)}` },
    { label: title, url: Astro.url.pathname },
];
---

<BaseLayout
    title={title}
    description={description}
    image={image?.src}
    imageAlt={imageAlt}
    canonical={canonical || Astro.url.pathname}
    article
    pubDate={pubDate}
    author={author}
    updatedDate={updatedDate}
    articleType={articleType}
    authorType={authorType}
    authorUrl={authorProfile.url}
    articleSection={category}
    keywords={[...topics, ...tags]}
    breadcrumbs={breadcrumbItems}
>
    <article class="article-page article-page-premium">
        <div class="article-shell">
            <Breadcrumbs items={breadcrumbItems} /><header
                class="article-header article-header-premium"
            >
                <div class="article-header-copy">
                    <div class="article-meta-top">
                        <span class="pill">{category}</span><span
                            class="article-type-badge">{contentType}</span
                        ><span class="article-type-badge">{difficulty}</span>
                    </div><h1>{title}</h1><p class="article-dek">
                        {description}
                    </p><div class="article-byline">
                        <a href={authorProfile.url} class="article-author"
                            >{author}</a
                        ><span aria-hidden="true">·</span><time
                            datetime={pubDate.toISOString()}
                            >{
                                pubDate.toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                })
                            }</time
                        ><span aria-hidden="true">·</span><span
                            >{readingTime} min read</span
                        ><span aria-hidden="true">·</span><span
                            >{
                                (updatedDate || pubDate).toLocaleDateString(
                                    "en-US",
                                    { month: "short", year: "numeric" },
                                )
                            }</span
                        >
                    </div>{
                        (updatedDate || lastReviewed) && (
                            <div class="article-review-line">
                                {updatedDate && (
                                    <span>
                                        Updated{" "}
                                        {updatedDate.toLocaleDateString(
                                            "en-US",
                                            {
                                                year: "numeric",
                                                month: "short",
                                                day: "numeric",
                                            },
                                        )}
                                    </span>
                                )}
                                {lastReviewed && (
                                    <span>
                                        Editorially reviewed{" "}
                                        {lastReviewed.toLocaleDateString(
                                            "en-US",
                                            {
                                                year: "numeric",
                                                month: "short",
                                                day: "numeric",
                                            },
                                        )}
                                    </span>
                                )}
                            </div>
                        )
                    }<div class="mt-5">
                        <ShareButtons url={Astro.url.href} title={title} />
                    </div>
                </div>{
                    image && (
                        <figure class="article-hero-media">
                            <Image
                                src={image}
                                alt={imageAlt || `Illustration for ${title}`}
                                width={1200}
                                height={630}
                                widths={[640, 960, 1200]}
                                sizes="(min-width:1024px) 470px,100vw"
                                quality={84}
                                loading="eager"
                                fetchpriority="high"
                                decoding="async"
                                class="w-full h-auto object-contain"
                                data-lightbox-src={image?.src}
                            />
                            {imageCaption && (
                                <figcaption>{imageCaption}</figcaption>
                            )}
                        </figure>
                    )
                }
            </header>
            {
                keyTakeaways.length > 0 && (
                    <section class="takeaways-card">
                        <>
                            <div>
                                <>
                                    <p class="section-kicker">At a glance</p>
                                    <h2>Key takeaways</h2>
                                </>
                            </div>
                            <ul>
                                {keyTakeaways.map((x) => (
                                    <li>
                                        <span>✓</span>
                                        <span>{x}</span>
                                    </li>
                                ))}
                            </ul>
                        </>
                    </section>
                )
            }
            <div
                class="article-learning-path"
                aria-label="AI Career Guide learning path"
            >
                <span class="article-learning-path-label"
                    >AI Career Guide method</span
                >
                <a href="/ai/">Learn</a>
                <span aria-hidden="true">→</span>
                <a href="/projects/">Build</a>
                <span aria-hidden="true">→</span>
                <a href="/careers/">Prove</a>
            </div>
            {
                headings.length > 0 && (
                    <div class="mobile-toc-card">
                        <details open>
                            <>
                                <summary>
                                    On this page{" "}
                                    <span>
                                        {
                                            headings.filter(
                                                (h) =>
                                                    h.depth === 2 ||
                                                    h.depth === 3,
                                            ).length
                                        }{" "}
                                        sections
                                    </span>
                                </summary>
                                <div class="mt-4">
                                    <TableOfContents headings={headings} />
                                </div>
                            </>
                        </details>
                    </div>
                )
            }
            {
                (prerequisites.length > 0 || nextSteps.length > 0) && (
                    <div class="article-context-grid">
                        {prerequisites.length > 0 && (
                            <section class="article-context-card">
                                <p class="context-label">Prerequisites</p>
                                <ul>
                                    {prerequisites.map((x) => (
                                        <li>{x}</li>
                                    ))}
                                </ul>
                            </section>
                        )}
                        {nextSteps.length > 0 && (
                            <section class="article-context-card">
                                <p class="context-label">Recommended next</p>
                                <ul>
                                    {nextSteps.map((x) => (
                                        <li>{x}</li>
                                    ))}
                                </ul>
                            </section>
                        )}
                    </div>
                )
            }
            <div class="article-content-kicker">
                <span>Deep dive</span>
                <span aria-hidden="true">•</span>
                <span>{readingTime} min read</span>
                <span aria-hidden="true">•</span>
                <span
                    >Updated {
                        (
                            updatedDate ||
                            lastReviewed ||
                            pubDate
                        ).toLocaleDateString("en-US", {
                            month: "short",
                            year: "numeric",
                        })
                    }</span
                >
            </div>
            <div class="article-content-layout article-reading-layout">
                <aside
                    class="article-sidebar hidden lg:block"
                    aria-label="Article navigation and context"
                >
                    <div class="article-sidebar-inner">
                        <div
                            class="article-sidebar-section article-sidebar-toc-section"
                        >
                            <div class="article-sidebar-label">
                                Navigate
                            </div><TableOfContents headings={headings} />
                        </div><div class="article-sidebar-divider"></div><div
                            class="article-sidebar-section"
                        >
                            <p class="context-label">Article details</p><div
                                class="sidebar-details"
                            >
                                <span>{difficulty}</span><span
                                    >{readingTime} min read</span
                                ><span>{category}</span><span
                                    >{contentType}</span
                                >
                            </div>
                        </div>{
                            prerequisites.length > 0 && (
                                <div class="article-sidebar-section">
                                    <>
                                        <p class="context-label">
                                            Prerequisites
                                        </p>
                                        <ul class="sidebar-list">
                                            {prerequisites.map((x) => (
                                                <li>{x}</li>
                                            ))}
                                        </ul>
                                    </>
                                </div>
                            )
                        }{
                            nextSteps.length > 0 && (
                                <div class="article-sidebar-section">
                                    <>
                                        <p class="context-label">Next</p>
                                        <ul class="sidebar-list">
                                            {nextSteps.slice(0, 4).map((x) => (
                                                <li>{x}</li>
                                            ))}
                                        </ul>
                                    </>
                                </div>
                            )
                        }
                    </div>
                </aside><div class="article-prose prose"><slot /></div>
            </div>
            <section
                class="article-build-next"
                aria-label="Next step after this article"
            >
                <div>
                    <p class="section-kicker">Learn → Build → Prove</p>
                    <h2>Turn this knowledge into evidence.</h2>
                    <p>
                        Use the related roadmap to choose what to learn next,
                        then build a project that demonstrates the skill instead
                        of stopping at theory.
                    </p>
                </div>
                <div class="article-build-actions">
                    <a href="/careers/" class="button-primary"
                        >Explore roadmaps →</a
                    >
                    <a href="/projects/" class="button-secondary"
                        >Build a project</a
                    >
                </div>
            </section>
            <footer class="article-footer">
                {
                    topics.length > 0 && (
                        <div class="article-taxonomy">
                            <span class="context-label">Topics</span>
                            {topics.map((x) => (
                                <span class="tag">{x}</span>
                            ))}
                        </div>
                    )
                }{
                    tags.length > 0 && (
                        <div class="article-taxonomy">
                            <span class="context-label">Tags</span>
                            {tags.map((x) => (
                                <span class="tag">#{x}</span>
                            ))}
                        </div>
                    )
                }{
                    sources.length > 0 && (
                        <section class="sources-card">
                            <>
                                <h2>Sources & references</h2>
                                <ul>
                                    {sources.map((source) => (
                                        <li>
                                            <a
                                                href={source.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                {source.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </>
                        </section>
                    )
                }{
                    (
                        <div class="article-feedback-card">
                            <div>
                                <p class="context-label">Found an error?</p>
                                <p class="text-sm text-[var(--color-text-secondary)]">
                                    Technical content changes quickly. Report a
                                    factual error or outdated reference so it
                                    can be checked.
                                </p>
                            </div>
                            <a
                                href={`/contact/?subject=${encodeURIComponent(`Correction: ${title}`)}`}
                                class="font-semibold text-[var(--color-accent)] hover:underline"
                            >
                                Report a correction →
                            </a>
                        </div>
                    )
                }{
                    (previousPost || nextPost) && (
                        <nav
                            class="article-next-nav"
                            aria-label="Article navigation"
                        >
                            {previousPost ? (
                                <a href={`/blog/${previousPost.id}/`}>
                                    <span>← Previous article</span>
                                    <strong>{previousPost.data.title}</strong>
                                </a>
                            ) : (
                                <span />
                            )}
                            {nextPost ? (
                                <a
                                    href={`/blog/${nextPost.id}/`}
                                    class="text-right"
                                >
                                    <span>Next article →</span>
                                    <strong>{nextPost.data.title}</strong>
                                </a>
                            ) : (
                                <span />
                            )}
                        </nav>
                    )
                }<AuthorBox author={author} />{
                    relatedPosts.length > 0 && (
                        <RelatedPosts posts={relatedPosts} />
                    )
                }
            </footer>
        </div>
    </article>

    <dialog
        id="article-image-lightbox"
        class="article-lightbox"
        aria-label="Image viewer"
    >
        <div class="article-lightbox-panel">
            <div class="article-lightbox-bar">
                <div class="min-w-0">
                    <p class="article-lightbox-kicker">Image preview</p>
                    <p
                        id="article-lightbox-caption"
                        class="article-lightbox-caption"
                    >
                        Expanded article image
                    </p>
                </div>
                <button
                    type="button"
                    id="article-lightbox-close"
                    class="article-lightbox-close"
                    aria-label="Close image viewer"
                >
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div
                id="article-lightbox-viewport"
                class="article-lightbox-viewport"
            >
                <img
                    id="article-lightbox-image"
                    class="article-lightbox-image"
                    alt=""
                    decoding="async"
                    draggable="false"
                />
            </div>
            <div
                class="article-lightbox-controls"
                aria-label="Image zoom controls"
            >
                <button
                    type="button"
                    id="article-lightbox-zoom-out"
                    class="article-lightbox-control"
                    aria-label="Zoom out">−</button
                >
                <span
                    id="article-lightbox-zoom-label"
                    class="article-lightbox-zoom-label">100%</span
                >
                <button
                    type="button"
                    id="article-lightbox-reset"
                    class="article-lightbox-control article-lightbox-reset"
                    aria-label="Reset zoom">Reset</button
                >
                <button
                    type="button"
                    id="article-lightbox-zoom-in"
                    class="article-lightbox-control"
                    aria-label="Zoom in">+</button
                >
            </div>
        </div>
    </dialog>

    <script>
        const initArticleImageLightbox = () => {
            const article =
                document.querySelector<HTMLElement>(".article-page");
            const dialog = document.getElementById(
                "article-image-lightbox",
            ) as HTMLDialogElement | null;
            const viewport = document.getElementById(
                "article-lightbox-viewport",
            );
            const viewer = document.getElementById(
                "article-lightbox-image",
            ) as HTMLImageElement | null;
            const caption = document.getElementById("article-lightbox-caption");
            const close = document.getElementById("article-lightbox-close");
            const zoomOut = document.getElementById(
                "article-lightbox-zoom-out",
            );
            const zoomIn = document.getElementById("article-lightbox-zoom-in");
            const reset = document.getElementById("article-lightbox-reset");
            const zoomLabel = document.getElementById(
                "article-lightbox-zoom-label",
            );
            if (
                !article ||
                !dialog ||
                !viewport ||
                !viewer ||
                !caption ||
                dialog.dataset.bound === "true"
            )
                return;
            dialog.dataset.bound = "true";

            let zoom = 1;
            const minZoom = 1;
            const maxZoom = 4;
            const step = 0.25;

            const updateZoom = (value: number) => {
                zoom = Math.min(
                    maxZoom,
                    Math.max(minZoom, Number(value.toFixed(2))),
                );
                viewer.style.transform = `scale(${zoom})`;
                viewer.style.transformOrigin = "center center";
                zoomLabel &&
                    (zoomLabel.textContent = `${Math.round(zoom * 100)}%`);
                zoomOut?.toggleAttribute("disabled", zoom <= minZoom);
                zoomIn?.toggleAttribute("disabled", zoom >= maxZoom);
                viewer.classList.toggle("is-zoomed", zoom > 1);
            };

            const closeDialog = () => {
                if (dialog.open) dialog.close();
                viewer.removeAttribute("src");
                viewer.alt = "";
                updateZoom(1);
                document.body.classList.remove("image-lightbox-open");
            };

            const openImage = (img: HTMLImageElement) => {
                const source =
                    img.dataset.lightboxSrc ||
                    img.currentSrc ||
                    img.getAttribute("src") ||
                    img.dataset.src;
                if (!source) return;
                viewer.src = source;
                viewer.alt = img.alt || "Expanded article image";
                const figure = img.closest("figure");
                const figcaption = figure
                    ?.querySelector("figcaption")
                    ?.textContent?.trim();
                caption.textContent =
                    figcaption || img.alt || "Expanded article image";
                updateZoom(1);
                document.body.classList.add("image-lightbox-open");
                if (typeof dialog.showModal === "function") dialog.showModal();
                else dialog.setAttribute("open", "true");
                requestAnimationFrame(() => {
                    viewport.scrollLeft = Math.max(
                        0,
                        (viewport.scrollWidth - viewport.clientWidth) / 2,
                    );
                    viewport.scrollTop = Math.max(
                        0,
                        (viewport.scrollHeight - viewport.clientHeight) / 2,
                    );
                    close?.focus({ preventScroll: true });
                });
            };

            article
                .querySelectorAll<HTMLImageElement>(
                    ".article-hero-media img, .article-prose img",
                )
                .forEach((img) => {
                    img.classList.add("article-lightbox-trigger");
                    img.tabIndex = 0;
                    img.setAttribute("role", "button");
                    img.setAttribute("aria-haspopup", "dialog");
                    img.setAttribute(
                        "aria-label",
                        `${img.alt || "Article image"}. Open image viewer.`,
                    );
                });

            article.addEventListener("click", (event) => {
                const target = event.target as HTMLElement | null;
                const img = target?.closest<HTMLImageElement>(
                    ".article-hero-media img, .article-prose img",
                );
                if (!img) return;
                event.preventDefault();
                openImage(img);
            });

            article.addEventListener("keydown", (event) => {
                const target = event.target as HTMLElement | null;
                const img = target?.closest<HTMLImageElement>(
                    ".article-hero-media img, .article-prose img",
                );
                if (!img) return;
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    openImage(img);
                }
            });

            close?.addEventListener("click", closeDialog);
            zoomOut?.addEventListener("click", () => updateZoom(zoom - step));
            zoomIn?.addEventListener("click", () => updateZoom(zoom + step));
            reset?.addEventListener("click", () => updateZoom(1));
            viewport.addEventListener("dblclick", () =>
                updateZoom(zoom === 1 ? 2 : 1),
            );
            viewport.addEventListener(
                "wheel",
                (event) => {
                    if (!event.ctrlKey) return;
                    event.preventDefault();
                    updateZoom(zoom + (event.deltaY < 0 ? step : -step));
                },
                { passive: false },
            );
            dialog.addEventListener("click", (event) => {
                if (event.target === dialog) closeDialog();
            });
            dialog.addEventListener("cancel", (event) => {
                event.preventDefault();
                closeDialog();
            });
            dialog.addEventListener("keydown", (event) => {
                if (event.key === "+" || event.key === "=")
                    updateZoom(zoom + step);
                if (event.key === "-") updateZoom(zoom - step);
                if (event.key === "0") updateZoom(1);
            });
            viewer.addEventListener("load", () => updateZoom(1));
            updateZoom(1);
        };

        initArticleImageLightbox();
        document.addEventListener("astro:page-load", initArticleImageLightbox);
    </script>
</BaseLayout>
