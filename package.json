{
  "name": "aicareerguide",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "content:check": "node scripts/content-check.mjs",
    "check": "npm run quality && npm run build && npm run rendered:audit",
    "test": "node --test tests/*.test.mjs",
    "content:freshness": "node scripts/content-freshness.mjs",
    "audit": "node scripts/site-audit.mjs",
    "rendered:audit": "node scripts/rendered-audit.mjs",
    "quality": "npm run audit && npm run content:check && npm test",
    "security:check": "npm audit --omit=dev"
  },
  "dependencies": {
    "astro": "^7.2.8",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.3",
    "@lucide/astro": "^1.34.0",
    "fuse.js": "^7.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "undici": "8.10.2",
    "sharp": "0.35.4",
    "js-yaml": "4.3.2"
  }
}
